# ── 관리자 로그인 ─────────────────────────────────────────────
ADMIN_ID=admin
ADMIN_PASSWORD=여기에-비밀번호를-정하세요

# ── 로그인 유지용 비밀키 ───────────────────────────────────────
# 아무 긴 문자열(영문·숫자 32자 이상). Vercel 배포 시 반드시 필요합니다.
# 선생님 PC에서 실행할 때는 비워 두어도 됩니다.
SESSION_SECRET=

# ── Supabase (인터넷 배포 시) ─────────────────────────────────
# 비워 두면 data/db.json 파일과 public/uploads 폴더에 저장합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 선택 사항 ────────────────────────────────────────────────
# NEXT_PUBLIC_SCHOOL_NAME=대구군위초등학교
# NEXT_PUBLIC_SITE_NAME=새싹 펀딩
